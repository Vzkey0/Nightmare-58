"values": [{"args": ["CamA"], "method": &"cut"}, {"args": ["", "(Una gaita en la radio.)"], "method": &"say"}, {"args": ["", ""], "method": &"say"}, {"args": ["CamA"], "method": &"cut"}, {"args": ["L", "Diez años, mano. Diez años y te vienes justo ahora."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["CamC"], "method": &"cut"}, {"args": ["P", "Mi mamá no contesta desde diciembre."], "method": &"say"}, {"args": ["Store"], "method": &"send"}, {"args": ["P", ""], "method": &"say"}, {"args": ["CamB"], "method": &"cut"}, {"args": ["L", "Aquí nadie contesta desde diciembre. No te lo tomes personal."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["L", "Te iba a decir que pusieras el aire, pero se dañó en 2016 y el repuesto cuesta más que el carro."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["CamA"], "method": &"cut"}, {"args": ["CamD"], "method": &"cut"}, {"args": ["L", "¿Ves esa cola? No saben qué llega. Hacen la cola por si acaso."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["P", "¿Y la gente cómo hace?"], "method": &"say"}, {"args": ["P", ""], "method": &"say"}, {"args": ["CamB"], "method": &"cut"}, {"args": ["L", "Los precios los cambian dos veces al día. En la mañana un kilo de harina, en la tarde lo mismo cuesta el doble."], "method": &"say"}, {"args": ["Bus"], "method": &"send"}, {"args": ["L", ""], "method": &"say"}, {"args": ["L", "Ya nadie cuenta los billetes. Los pesan."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["L", "Lo que hay lo tienen los bachaqueros, y te lo venden a lo que les da la gana."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["CamC"], "method": &"cut"}, {"args": ["L", "Mi abuelo guardaba lochas en una lata de galletas. Nos reíamos de él. Ahora valen más que un sueldo."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["CamA"], "method": &"cut"}, {"args": ["L", "Mi hermana se fue a Bogotá. Mis primos a Lima. Los del edificio... ni sé."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["L", "Antes la gente se iba por el aeropuerto. Ahora se va caminando."], "method": &"say"}, {"args": ["SplitBuilding"], "method": &"send"}, {"args": ["L", ""], "method": &"say"}, {"args": ["P", "¿Y tú por qué te quedaste?"], "method": &"say"}, {"args": ["P", ""], "method": &"say"}, {"args": ["CamB"], "method": &"cut"}, {"args": ["", "(Luis se ríe sin ganas.)"], "method": &"say"}, {"args": ["L", "Alguien tenía que buscarte en el aeropuerto, ¿no?"], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["L", "Ahí atrás hay un machete. No preguntes. Aquí ya nadie sale sin uno."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["CamD"], "method": &"cut"}, {"args": ["L", "Y después vino el terremoto. Cuarenta segundos."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["L", "Cuarenta segundos y se cayó media ciudad. Lo que la crisis no tumbó, lo tumbó eso."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["P", "No salió casi nada afuera."], "method": &"say"}, {"args": ["P", ""], "method": &"say"}, {"args": ["CamB"], "method": &"cut"}, {"args": ["L", "Porque no quedó nadie para contarlo. Se cayeron las antenas y la luz, y después ya nadie volvió a levantarlas."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["L", "Del otro lado, donde vive tu mamá, no se sabe nada desde entonces."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["CamA"], "method": &"cut"}, {"args": ["L", "Pero la vieja es dura, mano. Si alguien aguantó, fue ella."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["", "(La gaita se corta. Estática.)"], "method": &"say"}, {"args": ["", ""], "method": &"say"}, {"args": ["L", "Esta radio también se está muriendo."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["Skeletons"], "method": &"send"}, {"args": ["", "(Bajo la lluvia, un silbido. Lejos.)"], "method": &"say"}, {"args": ["", ""], "method": &"say"}, {"args": ["P", "¿Oíste eso?"], "method": &"say"}, {"args": ["P", ""], "method": &"say"}, {"args": ["L", "¿Qué cosa?"], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["L", "¿Y eso qué...?"], "method": &"say"}, {"args": ["L", "¡Agárrate!"], "method": &"say"}, {"args": ["", ""], "method": &"say"}, {"args": ["CamSeat"], "method": &"cut"}, {"args": ["", "(Un pito en los oídos.)"], "method": &"say"}, {"args": ["", ""], "method": &"say"}, {"args": ["L", "(Débil) Vete..."], "method": &"say"}, {"args": ["L", ""], "method": &"say"}, {"args": ["CamBack"], "method": &"cut"}, {"args": ["CamOut"], "method": &"cut"}, {"args": [], "method": &"finish"}]
}
